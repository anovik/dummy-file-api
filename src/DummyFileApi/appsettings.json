{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Default": "Data Source=dummyfileapi.db"
  },
  "FileGeneration": {
    "MaxSizeBytes": 104857600
  },
  "AllowedHosts": "*"
}
